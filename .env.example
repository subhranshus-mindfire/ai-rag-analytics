# Application Settings
APP_NAME="AI RAG & Analytics Assistant"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# LLM Provider Configuration
# Choose: "groq", "gemini", or "ollama"
LLM_PROVIDER="groq"

# Free Cloud LLM API Keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Ollama (Local Fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Embedding Model Configuration
# Uses fastembed (lightweight, runs locally without GPU) or sentence-transformers
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# Qdrant Vector Database
# Set QDRANT_URL to empty or ":memory:" or "./qdrant_data" for local embedded mode,
# or "http://localhost:6333" for Docker container mode.
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION_NAME="documents"

# PostgreSQL Database Configuration
POSTGRES_USER="ai_user"
POSTGRES_PASSWORD="ai_password"
POSTGRES_DB="ai_analytics"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://ai_user:ai_password@localhost:5432/ai_analytics"
